<Window x:Class="JMBNOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="JMBN Polaris Overlay" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" Topmost="True" ShowInTaskbar="True"
 Width="1180" Height="700" MinWidth="720" MinHeight="430" ResizeMode="CanResizeWithGrip">
 <Grid Margin="14">
  <Border Background="#E0080A08" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#D00C0E0B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
     <TextBlock x:Name="MissionTitle" Text="JMBN // POLARIS" Foreground="#D7B66A" FontFamily="Play" FontWeight="Bold" FontSize="17" Margin="16,0" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock x:Name="StatusText" Text="OPERATION NOT LOADED" Foreground="#91A68B" FontFamily="Play" Margin="0,0,18,0"/>
      <Button Content="×" Width="32" Height="26" Click="CloseButton_Click"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="MapRoot" Background="#01000000">
     <Image x:Name="ShipImage" Source="https://delumenta.github.io/onthego/assets/polaris-stations.jpg" Stretch="Uniform" SizeChanged="ShipImage_SizeChanged"/>
     <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
     <Border x:Name="LoadPanel" Width="390" Padding="22" Background="#F20A0C09" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
       <TextBlock Text="JMBN // MISSION OVERLAY" Foreground="#D7B66A" FontFamily="Play" FontWeight="Bold" FontSize="18"/>
       <TextBlock x:Name="PanelPrompt" Text="SIGN IN TO JMBN MANIFEST" Foreground="#777D74" FontFamily="Play" FontSize="11" Margin="0,18,0,6"/>
       <TextBox x:Name="UsernameBox" Height="32" Margin="0,0,0,8" ToolTip="Username or email"/>
       <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,0,0,10" ToolTip="Password"/>
       <Button x:Name="LoginButton" Content="SIGN IN" Height="36" Click="Login_Click"/>
       <TextBlock x:Name="LoginError" Foreground="#D98272" FontFamily="Play" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <StackPanel x:Name="MissionPanel" Visibility="Collapsed">
        <TextBlock x:Name="ActiveOperationText" Text="CHECKING COMMAND OPERATION…" Foreground="#D7B66A" FontFamily="Play" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
    <Grid Grid.Row="2" Background="#D00C0E0B">
     <StackPanel Margin="16,8" VerticalAlignment="Center">
      <TextBlock x:Name="AssignmentText" Text="YOUR STATION // NOT ASSIGNED" Foreground="#D7B66A" FontFamily="Play" FontWeight="Bold" FontSize="11"/>
      <TextBlock x:Name="ManningText" Text="0 / 12 STATIONS MANNED" Foreground="#777D74" FontFamily="Play" FontSize="10" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
      <Button x:Name="AckButton" Content="ACKNOWLEDGE" Width="118" Height="32" Margin="0,0,8,0" Click="AckButton_Click" IsEnabled="False"/>
      <Button x:Name="SeatButton" Content="ON STATION" Width="112" Height="32" Click="SeatButton_Click" IsEnabled="False"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>