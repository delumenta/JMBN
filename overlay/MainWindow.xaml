<Window x:Class="JMBNOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="JMBN Polaris Overlay" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" Topmost="True" ShowInTaskbar="True"
 Width="1180" Height="700" ResizeMode="CanResizeWithGrip">
 <Grid Margin="14">
  <Border Background="#D9080A08" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#B90C0E0B">
     <TextBlock Text="JMBN // POLARIS" Foreground="#D7B66A" FontFamily="Play" FontWeight="Bold" FontSize="17" Margin="16,0" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
      <TextBlock x:Name="StatusText" Text="LOCAL PREVIEW" Foreground="#91A68B" FontFamily="Play" Margin="0,0,18,0"/>
      <Button x:Name="CloseButton" Content="×" Width="32" Height="26" Click="CloseButton_Click"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" x:Name="MapRoot">
     <Image x:Name="ShipImage" Source="https://delumenta.github.io/onthego/assets/polaris-stations.jpg" Stretch="Uniform"/>
     <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
    </Grid>
    <Grid Grid.Row="2" Background="#B90C0E0B">
     <TextBlock x:Name="ManningText" Text="0 / 12 STATIONS MANNED" Foreground="#B6B8AE" FontFamily="Play" FontSize="11" Margin="16,0" VerticalAlignment="Center"/>
     <TextBlock Text="ALT+J SHOW/HIDE  •  F8 CLICK-THROUGH" Foreground="#6F756D" FontFamily="Play" FontSize="10" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>