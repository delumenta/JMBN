<Window x:Class="JMBNOverlay.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="JMBN Polaris Overlay" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" Topmost="True" ShowInTaskbar="True"
 Width="1320" Height="820" MinWidth="820" MinHeight="560" ResizeMode="CanResizeWithGrip" FontFamily="Play">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="FontFamily" Value="Play"/><Setter Property="Background" Value="#090A08"/><Setter Property="Foreground" Value="#D7B66A"/><Setter Property="BorderBrush" Value="#D7B66A"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="FontFamily" Value="Play"/>
   <Setter Property="Background" Value="#050605"/>
   <Setter Property="Foreground" Value="#D7B66A"/>
   <Setter Property="BorderBrush" Value="#8E7546"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,3"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="Shell" Background="#050605" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
         <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="#D7B66A"/>
         <Border Grid.Column="1" BorderBrush="#40351F" BorderThickness="1,0,0,0">
          <Path Width="8" Height="5" Fill="#D7B66A" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 5 Z"/>
         </Border>
        </Grid>
       </Border>
       <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Opacity="0"/>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border Background="#050605" BorderBrush="#8E7546" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
         <ScrollViewer><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#D7B66A"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".55"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="FontFamily" Value="Play"/><Setter Property="Background" Value="#050605"/><Setter Property="Foreground" Value="#D7B66A"/><Setter Property="Padding" Value="8,6"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#1A170F"/><Setter Property="Foreground" Value="#F1D28A"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#241E10"/><Setter Property="Foreground" Value="#F1D28A"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="8">
  <Border Background="#E0080A08" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="82"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#F00B0D0B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <Border Width="27" Height="27" CornerRadius="14" BorderBrush="#D7B66A" BorderThickness="1.5" Margin="0,0,10,0"><TextBlock Text="J" Foreground="#D7B66A" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="JMBN OPERATIONS COMPANION" Foreground="#D7B66A" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
      <Ellipse Width="8" Height="8" Fill="#79D889" Margin="0,0,7,0"/>
      <TextBlock x:Name="StatusText" Text="OPERATION NOT LOADED" Foreground="#91A68B" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <Button Content="—" Width="30" Height="26" Click="MinimizeButton_Click" BorderThickness="0"/>
      <Button Content="□" Width="30" Height="26" Click="MaximizeButton_Click" BorderThickness="0"/>
      <Button Content="×" Width="30" Height="26" Click="CloseButton_Click" BorderThickness="0"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Background="#F0080908">
     <Border BorderBrush="#5C4B2C" BorderThickness="0,1,0,1">
      <Grid Margin="14,0">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ShellReadyRoomTab" Content="READY ROOM" Width="108" Height="30" Click="ReadyRoomTab_Click" Background="#241E10" Foreground="#F1D28A" BorderThickness="0,0,0,2"/>
        <Button x:Name="ShellTacticalTab" Content="TACTICAL" Width="92" Height="30" Margin="5,0,0,0" Click="TacticalTab_Click" BorderThickness="0"/>
        <Button x:Name="ShellCrewTab" Content="CREW" Width="72" Height="30" Margin="5,0,0,0" Click="CrewTab_Click" BorderThickness="0"/>
        <Button x:Name="ShellGlossaryTab" Content="GLOSSARY" Width="92" Height="30" Margin="5,0,0,0" Click="GlossaryTab_Click" BorderThickness="0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ShellCommandButton" Content="COMMAND" Width="92" Height="30" Visibility="Collapsed" Click="CommandTab_Click"/>
        <Button Content="⚙" Width="34" Height="30" Margin="7,0,0,0" Click="SettingsButton_Click"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="2" x:Name="MapRoot" Background="#01000000" ClipToBounds="True">
     <Image x:Name="ShipImage" Source="https://delumenta.github.io/onthego/assets/polaris-stations.jpg" Stretch="Uniform" SizeChanged="ShipImage_SizeChanged"/>
     <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="5">
      <Button x:Name="ReadyRoomTab" Content="READY ROOM" Width="108" Height="28" Click="ReadyRoomTab_Click" Background="#D7B66A" Foreground="#090A08" BorderBrush="#D7B66A"/>
      <Button x:Name="OverviewTab" Content="OVERVIEW" Width="92" Height="28" Margin="6,0,0,0" Click="OverviewTab_Click" Background="#D00C0E0B" Foreground="#D7B66A" BorderBrush="#8E7546"/>
      <Button x:Name="CrewTab" Content="CREW" Width="68" Height="28" Margin="6,0,0,0" Click="CrewTab_Click" Background="#D00C0E0B" Foreground="#D7B66A" BorderBrush="#8E7546"/>
      <Button x:Name="CommandTab" Content="COMMAND" Width="92" Height="28" Margin="6,0,0,0" Visibility="Collapsed" Click="CommandTab_Click" Background="#D00C0E0B" Foreground="#D7B66A" BorderBrush="#8E7546"/>
     </StackPanel>
     <Border x:Name="ReadyRoomPanel" Margin="26,54,26,24" Background="#F4080A08" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="6" Panel.ZIndex="8">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="145"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
       <Grid Grid.Row="0" Margin="26,20,26,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel Orientation="Horizontal"><TextBlock x:Name="ReadyRoomOperation" Text="OPERATION // STANDING BY" Foreground="#E8E8E8" FontSize="29" FontWeight="Bold"/><Border Margin="14,4,0,0" Padding="10,3" Height="28" BorderBrush="#8E7546" BorderThickness="1" CornerRadius="9"><TextBlock Text="FORMING" Foreground="#D7B66A" FontSize="11" FontWeight="Bold"/></Border></StackPanel>
         <TextBlock x:Name="ReadyRoomMissionTime" Text="AWAITING ACTIVE OPERATION" Foreground="#B7B7B7" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
         <TextBlock Text="Crew preparation and station readiness for the current JMBN operation." Foreground="#A6A6A6" FontSize="12" Margin="0,15,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Margin="20,0,0,0" Padding="22,16" BorderBrush="#5C4B2C" BorderThickness="1,0,0,0">
         <StackPanel VerticalAlignment="Center"><TextBlock Text="ASSIGNED SHIP" Foreground="#8B8B8B" FontSize="11" FontWeight="Bold"/><TextBlock Text="RSI POLARIS" Foreground="#E8E8E8" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="JMBN OPERATIONS" Foreground="#777D74" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        </Border>
       </Grid>
       <Grid Grid.Row="1" Background="#B8060706">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="28,18,20,12">
         <TextBlock Text="YOUR ASSIGNMENT" Foreground="#D7B66A" FontSize="14" FontWeight="Bold"/>
         <TextBlock Text="ROLE / STATION" Foreground="#777D74" FontSize="9" Margin="0,14,0,0"/>
         <TextBlock x:Name="ReadyRoomAssignment" Text="NOT ASSIGNED" Foreground="#E8E8E8" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
         <TextBlock x:Name="ReadyRoomCallsign" Text="JMBN CREW" Foreground="#777D74" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="26,18,28,12">
         <TextBlock x:Name="ReadyRoomCrew" Text="CREW (0 READY)" Foreground="#E8E8E8" FontSize="14" FontWeight="Bold"/>
         <ProgressBar x:Name="ReadyRoomProgress" Height="15" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="0" Foreground="#D7B66A" Background="#252621" BorderBrush="#5C4B2C"/>
         <TextBlock x:Name="ReadyRoomCrewDetail" Text="Waiting for crew readiness." Foreground="#777D74" FontSize="11" Margin="0,10,0,0"/>
        </StackPanel>
       </Grid>
       <Grid Grid.Row="2" Margin="28,16,28,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="PRE-DEPLOYMENT CHECKLIST" Foreground="#D7B66A" FontSize="15" FontWeight="Bold"/>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
         <Border Margin="0,0,7,0" Padding="14" BorderBrush="#8E7546" BorderThickness="1" CornerRadius="4"><StackPanel VerticalAlignment="Center"><TextBlock Text="⌖" Foreground="#D7B66A" FontSize="28" TextAlignment="Center"/><TextBlock Text="LOADOUT READY" Foreground="#E8E8E8" FontSize="14" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="Weapon, ammo and gear set." Foreground="#8B8B8B" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,10"/><CheckBox x:Name="LoadoutCheck" HorizontalAlignment="Center" Checked="PreflightCheck_Changed" Unchecked="PreflightCheck_Changed"/></StackPanel></Border>
         <Border Margin="7,0" Padding="14" BorderBrush="#8E7546" BorderThickness="1" CornerRadius="4"><StackPanel VerticalAlignment="Center"><TextBlock Text="◡" Foreground="#D7B66A" FontSize="28" TextAlignment="Center"/><TextBlock Text="BIO BREAK COMPLETE" Foreground="#E8E8E8" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Take care of it now." Foreground="#8B8B8B" FontSize="10" TextAlignment="Center" Margin="0,8,0,10"/><CheckBox x:Name="BioCheck" HorizontalAlignment="Center" Checked="PreflightCheck_Changed" Unchecked="PreflightCheck_Changed"/></StackPanel></Border>
         <Border Margin="7,0" Padding="14" BorderBrush="#8E7546" BorderThickness="1" CornerRadius="4"><StackPanel VerticalAlignment="Center"><TextBlock Text="◉" Foreground="#D7B66A" FontSize="28" TextAlignment="Center"/><TextBlock Text="COMMS READY" Foreground="#E8E8E8" FontSize="14" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="Mic working and in channel." Foreground="#8B8B8B" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,10"/><CheckBox x:Name="CommsCheck" HorizontalAlignment="Center" Checked="PreflightCheck_Changed" Unchecked="PreflightCheck_Changed"/></StackPanel></Border>
         <Border Margin="7,0,0,0" Padding="14" BorderBrush="#8E7546" BorderThickness="1" CornerRadius="4"><StackPanel VerticalAlignment="Center"><TextBlock Text="✚" Foreground="#D7B66A" FontSize="28" TextAlignment="Center"/><TextBlock Text="MEDBAY RESPAWN SET" Foreground="#E8E8E8" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="Respawn point set at Medbay." Foreground="#8B8B8B" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,10"/><CheckBox x:Name="MedbayCheck" HorizontalAlignment="Center" Checked="PreflightCheck_Changed" Unchecked="PreflightCheck_Changed"/></StackPanel></Border>
        </UniformGrid>
       </Grid>
       <Button Grid.Row="3" x:Name="DeploymentReadyButton" Content="✓  READY FOR DEPLOYMENT" Margin="28,8,28,16" FontSize="16" FontWeight="Bold" IsEnabled="False" Click="DeploymentReadyButton_Click"/>
      </Grid>
     </Border>
     <Border x:Name="GlossaryPanel" Margin="26,54,26,24" Padding="28" Background="#F4080A08" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="6" Visibility="Collapsed" Panel.ZIndex="9">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="COMMAND GLOSSARY" Foreground="#E8E8E8" FontSize="28" FontWeight="Bold"/><TextBlock Text="JMBN shipboard terminology and weapons-control calls." Foreground="#777D74" FontSize="11" Margin="0,5,0,16"/></StackPanel>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="SHIP ORIENTATION" Foreground="#D7B66A" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="PORT / PORTSIDE — Left side of ship&#x0a;STARBOARD — Right side of ship&#x0a;FORE / BOW — Front of ship&#x0a;AFT / STERN — Rear of ship&#x0a;STARBOARD BOW — Front right&#x0a;PORT BOW — Front left&#x0a;STARBOARD REAR — Right rear&#x0a;PORT REAR — Left rear" Foreground="#E8E8E8" FontSize="12" LineHeight="22"/>
        <TextBlock Text="CONTACTS &amp; WEAPONS CONTROL" Foreground="#D7B66A" FontSize="14" FontWeight="Bold" Margin="0,20,0,8"/>
        <TextBlock Text="BOGEY — White contact; neutral / unknown&#x0a;BANDIT — Red contact; hostile&#x0a;WEAPONS SECURE — No shooting&#x0a;WEAPONS HOLD — Ready to shoot on orders&#x0a;WEAPONS TIGHT — Shoot bandits&#x0a;WEAPONS FREE — Shoot anything not friendly / blue" Foreground="#E8E8E8" FontSize="12" LineHeight="22"/>
        <TextBlock Text="MISSILES &amp; MOUNTS" Foreground="#D7B66A" FontSize="14" FontWeight="Bold" Margin="0,20,0,8"/>
        <TextBlock Text="VAMPIRE — Incoming missile&#x0a;BIRD — Outgoing missile&#x0a;BULLDOG — Torpedo / heavy anti-ship missile&#x0a;6-1 — Main S6 gun&#x0a;4-1 — Port S4 turret&#x0a;4-2 — Starboard S4 turret&#x0a;3-1 / 3-2 — S3 turrets" Foreground="#E8E8E8" FontSize="12" LineHeight="22"/>
       </StackPanel></ScrollViewer>
      </Grid>
     </Border>
     <Border x:Name="InfoPanel" Width="330" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,10,10" Background="#F20A0C09" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5" Visibility="Collapsed" Panel.ZIndex="6">
      <StackPanel>
       <Grid><TextBlock x:Name="InfoPanelTitle" Text="OVERVIEW" Foreground="#D7B66A" FontWeight="Bold" FontSize="18"/><Button Content="×" Width="28" Height="24" HorizontalAlignment="Right" Click="InfoClose_Click"/></Grid>
       <StackPanel x:Name="OverviewPanel" Margin="0,16,0,0">
        <TextBlock Text="OPERATION" Foreground="#777D74" FontSize="9"/><TextBlock x:Name="OverviewOperation" Text="NO ACTIVE OPERATION" Foreground="#E8E8E8" FontSize="13" FontWeight="Bold" Margin="0,3,0,14"/>
        <TextBlock Text="CREW STATUS" Foreground="#777D74" FontSize="9"/><TextBlock x:Name="OverviewCrew" Text="0 / 13 STATIONS MANNED" Foreground="#E8E8E8" FontSize="12" Margin="0,3,0,14"/>
        <TextBlock Text="READINESS" Foreground="#777D74" FontSize="9"/><TextBlock x:Name="OverviewReadiness" Text="0 ASSIGNED · 0 ACKNOWLEDGED · 0 ON STATION" Foreground="#E8E8E8" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,14"/>
        <TextBlock Text="YOUR ASSIGNMENT" Foreground="#777D74" FontSize="9"/><TextBlock x:Name="OverviewAssignment" Text="NOT ASSIGNED" Foreground="#D7B66A" FontSize="12" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
       </StackPanel>
       <ScrollViewer x:Name="CrewPanel" Visibility="Collapsed" MaxHeight="520" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CrewListPanel"/></ScrollViewer>
      </StackPanel>
     </Border>
     <Border x:Name="LoadPanel" Panel.ZIndex="20" Width="390" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,48,10,10" Background="#FF0A0C09" BorderBrush="#9C8060" BorderThickness="1" CornerRadius="5" IsHitTestVisible="True">
      <StackPanel>
       <Grid><TextBlock Text="COMMAND // STATION ASSIGNMENT" Foreground="#D7B66A" FontWeight="Bold" FontSize="18"/><Button x:Name="DrawerCloseButton" Content="×" Width="28" Height="24" HorizontalAlignment="Right" Click="CommandTab_Click" Visibility="Collapsed"/></Grid>
       <TextBlock x:Name="PanelPrompt" Text="SIGN IN TO JMBN MANIFEST" Foreground="#777D74" FontSize="11" Margin="0,18,0,6"/>
       <Button x:Name="LoginButton" Content="SIGN IN WITH DISCORD" Height="38" Margin="0,6,0,0" Click="Login_Click"/>
       <TextBlock x:Name="LoginError" Foreground="#D98272" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <StackPanel x:Name="MissionPanel" Visibility="Collapsed">
        <TextBlock x:Name="ActiveOperationText" Text="CHECKING COMMAND OPERATION…" Foreground="#D7B66A" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <StackPanel x:Name="CommandPanel" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock Text="COMMAND // LOAD MISSION" Foreground="#777D74" FontSize="10" Margin="0,0,0,6"/>
         <ComboBox x:Name="MissionPicker" Height="32"/>
         <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="LOAD MISSION" Width="145" Height="32" Click="LoadMission_Click"/><Button Content="END OPERATION" Width="145" Height="32" Margin="8,0,0,0" Click="EndMission_Click"/></StackPanel>
         <Button Content="ASSIGN STATIONS" Height="32" Margin="0,10,0,0" Click="AssignStations_Click"/>
         <ScrollViewer x:Name="StationAssignScroll" Visibility="Collapsed" MaxHeight="390" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="StationAssignPanel"/></ScrollViewer>
        </StackPanel>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
    <Grid Grid.Row="3" Background="#F00A0C09">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="16,9,12,8" VerticalAlignment="Center">
      <TextBlock Text="YOUR STATION" Foreground="#777D74" FontSize="9" FontWeight="Bold"/>
      <TextBlock x:Name="AssignmentText" Text="NOT ASSIGNED" Foreground="#D7B66A" FontWeight="Bold" FontSize="13" Margin="0,3,0,4"/>
      <StackPanel Orientation="Horizontal">
       <Ellipse x:Name="PersonalStatusDot" Width="14" Height="14" Stroke="#E8E8E8" StrokeThickness="2" Fill="Transparent" Margin="0,0,7,0"/>
       <TextBlock x:Name="PersonalStatusText" Text="NOT ASSIGNED" Foreground="#E8E8E8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
      <Button x:Name="AckButton" Content="ACKNOWLEDGE" Width="118" Height="32" Margin="0,0,8,0" Click="AckButton_Click" IsEnabled="False"/>
      <Button x:Name="SeatButton" Content="ON STATION" Width="112" Height="32" Click="SeatButton_Click" IsEnabled="False" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="4" Background="#F0070807">
     <Border BorderBrush="#806A3E" BorderThickness="0,1,0,0" Padding="16,5">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse Width="18" Height="18" Stroke="#E8E8E8" StrokeThickness="2" Fill="Transparent"/><StackPanel Margin="8,0,28,0"><TextBlock Text="UNASSIGNED" Foreground="#E8E8E8" FontSize="10" FontWeight="Bold"/><TextBlock Text="Station empty" Foreground="#777D74" FontSize="8"/></StackPanel>
       <Ellipse Width="18" Height="18" Stroke="#D7B66A" StrokeThickness="2" Fill="Transparent"/><StackPanel Margin="8,0,28,0"><TextBlock Text="ASSIGNED" Foreground="#E8E8E8" FontSize="10" FontWeight="Bold"/><TextBlock Text="Another crew member" Foreground="#777D74" FontSize="8"/></StackPanel>
       <Border Width="24" Height="24" Margin="0" CornerRadius="12" BorderBrush="#FFD36A" BorderThickness="2" Background="Transparent"><Border.Effect><DropShadowEffect Color="#FFC23A" BlurRadius="14" ShadowDepth="0" Opacity=".95"/></Border.Effect></Border><StackPanel Margin="8,0,28,0"><TextBlock Text="YOUR ASSIGNMENT" Foreground="#D7B66A" FontSize="10" FontWeight="Bold"/><TextBlock Text="Acknowledge to confirm" Foreground="#777D74" FontSize="8"/></StackPanel>
       <Ellipse Width="18" Height="18" Stroke="#D7B66A" StrokeThickness="2" Fill="#D7B66A"><Ellipse.Effect><DropShadowEffect Color="#FFC23A" BlurRadius="12" ShadowDepth="0" Opacity=".8"/></Ellipse.Effect></Ellipse><StackPanel Margin="8,0,0,0"><TextBlock Text="ACKNOWLEDGED" Foreground="#E8E8E8" FontSize="10" FontWeight="Bold"/><TextBlock Text="Assignment confirmed" Foreground="#777D74" FontSize="8"/></StackPanel>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>